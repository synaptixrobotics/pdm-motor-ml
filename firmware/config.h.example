/* =====================================================================
 *  config.h.example  ->  copy to config.h before building
 *
 *  config.h itself is gitignored because it holds your Wi-Fi password.
 *  Copy this file to firmware/config.h and fill in SSID and password
 *  there; your credentials then stay on your machine only.
 *
 *  config.h  —  Synaptix Robotics
 *  ML-Based Predictive Maintenance of Electrical Motors
 *  Edit everything project-specific here. Nothing else needs changing.
 * ===================================================================== */
#ifndef CONFIG_H
#define CONFIG_H

/* ---------------- Wi-Fi ---------------- */
#define WIFI_SSID           "YOUR_WIFI_SSID"
#define WIFI_PASSWORD       "YOUR_WIFI_PASSWORD"
#define MDNS_HOST           "synaptix-pdm"      // http://synaptix-pdm.local
#define AP_FALLBACK_SSID    "Synaptix-PDM"      // if Wi-Fi fails -> AP mode
#define AP_FALLBACK_PASS    "synaptix123"

/* ---------------- Sensor front-end -----------------------------------
 * The ESP8266 has only ONE ADC pin (A0), which used to be the problem:
 * two analog sensors (voltage + ACS712 current) needed two channels, so
 * an ADS1115 had to arbitrate. The INA219 removes that constraint — it
 * carries its own shunt and 12-bit ADC and reports amps over I2C as a
 * number, leaving A0 free for the voltage module.
 *
 *   CURRENT_SENSOR_FITTED = 1 -> INA219 in series with the motor's
 *                                positive lead, after the relay.
 *                                Mechanical Overload class and the
 *                                current trip are both live.
 *   CURRENT_SENSOR_FITTED = 0 -> no current sensor, and no I2C bus
 *                                started at all. The dashboard shows
 *                                "No sensor" on the current tile, the
 *                                overload class never fires, and the
 *                                model runs on an imputed value.
 *                                Voltage, temperature and vibration
 *                                protection are unaffected.
 *
 * VOLTAGE_SENSOR_FITTED = 0 reports "no sensor" rather than a fake
 * 0.00 V, which the model would otherwise classify as a brownout.
 * -------------------------------------------------------------------- */
#define CURRENT_SENSOR_FITTED  1
#define VOLTAGE_SENSOR_FITTED  1

/* ---------------- GPIO map (NodeMCU / Wemos D1 mini) ---------------- */
#define PIN_I2C_SDA         4    // D2  -> INA219 SDA
#define PIN_I2C_SCL         5    // D1  -> INA219 SCL
#define PIN_DHT             2    // D4  -> DHT11 DATA
#define PIN_RELAY          14    // D5  -> relay module IN
#define PIN_VIBRATION      12    // D6  -> SW-420 DO (digital, interrupt)
#define PIN_BUZZER         13    // D7  -> active buzzer (optional)
#define PIN_RESET_BTN       0    // D3  -> FLASH button, latch reset (to GND)
#define PIN_VOLT_ADC       A0    // A0  -> voltage sensor S (module output)

#define RELAY_ACTIVE_LOW    1    // most blue relay boards are active LOW
#define BUZZER_FITTED       1    // 0 if you did not wire a buzzer
#define INA219_ADDR         0x40 // A0 and A1 address pads -> GND

/* ---------------- Sensor calibration ----------------------------------
 * VOLT_DIVIDER_RATIO : for the common "Voltage Sensor 0-25V" module the
 *   on-board divider is 30k/7.5k = 5.0 . Measure with a multimeter and
 *   tune until the dashboard matches reality.
 * INA219_CAL : measuring range. 2 (32 V / 2 A, 100 uA per bit) leaves
 *   headroom above the 1.2 A trip and is the right choice for a 6 V DC
 *   motor. Use 1 for a finer 1 A range only if the motor's stall current
 *   is comfortably under 1 A — above the range the reading saturates.
 * ------------------------------------------------------------------- */
#define VOLT_DIVIDER_RATIO  5.00f
#define VOLT_TRIM           1.000f   // fine-trim multiplier
#define ESP_ADC_FS_VOLTS    3.20f    // NodeMCU A0 full scale (has divider)

#define INA219_CAL          2        // 0 = 16V/400mA, 1 = 32V/1A, 2 = 32V/2A
#define CURRENT_DEADBAND_A  0.02f    // ignore noise below this

/* ---------------- Protection thresholds (runtime-editable) ---------- */
#define TH_VOLTAGE_MAX      6.00f    // V   -> required: alert above 6 V
#define TH_VOLTAGE_MIN      3.50f    // V   -> undervoltage / brownout
#define TH_CURRENT_MAX      1.20f    // A   -> overload for a small DC motor
#define TH_TEMP_WARN       45.0f     // degC
#define TH_TEMP_MAX        55.0f     // degC -> trip
#define TH_VIB_WARN        18.0f     // events/s
#define TH_VIB_MAX         35.0f     // events/s -> trip

/* ---------------- Timing ---------------- */
#define SAMPLE_WINDOW_MS    1000UL   // one feature frame per second
#define DHT_PERIOD_MS       2200UL   // DHT11 cannot be read faster
#define HISTORY_LEN         120      // 2 minutes of 1 Hz samples kept in RAM

#endif // CONFIG_H
